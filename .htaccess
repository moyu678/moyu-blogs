<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^uploads/ - [L]
    RewriteRule ^admin\.php - [L]
    RewriteRule ^install\.php - [L]
    RewriteRule ^api\.php - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
Options -Indexes